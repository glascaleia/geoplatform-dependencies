<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.geosdi</groupId>
        <artifactId>geoplatform-dependencies</artifactId>
        <version>2.1-SNAPSHOT</version>
    </parent>

    <groupId>org.geosdi</groupId>
    <artifactId>geoplatform-gwt-dependency</artifactId>
    <version>2.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Geo-Platform :: == GWT Dependencies Module</name>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>org.gwtproject</groupId>
                <artifactId>gwt-user</artifactId>
                <version>${gwt.version}</version>
            </dependency>

            <dependency>
                <groupId>org.gwtproject</groupId>
                <artifactId>gwt-servlet-jakarta</artifactId>
                <version>${gwt.version}</version>
            </dependency>

            <dependency>
                <groupId>org.gwtproject</groupId>
                <artifactId>gwt-dev</artifactId>
                <version>${gwt.version}</version>
            </dependency>

            <!-- GXT -->
            <dependency>
                <groupId>com.extjs</groupId>
                <artifactId>gxt</artifactId>
                <version>${gxt.version}</version>
            </dependency>

            <dependency>
                <groupId>org.gwtproject.web.bindery</groupId>
                <artifactId>requestfactory-server</artifactId>
                <version>${gwt.version}</version>
            </dependency>

            <dependency>
                <groupId>com.extjs</groupId>
                <artifactId>gxt</artifactId>
                <classifier>sources</classifier>
                <version>${gxt.version}</version>
            </dependency>

            <!-- RESTYGWT -->
            <dependency>
                <groupId>org.fusesource.restygwt</groupId>
                <artifactId>restygwt</artifactId>
                <version>${restygwt.version}</version>
            </dependency>

            <!-- DOMINO REST (client REST da interfacce jakarta.ws.rs) e DOMINO JACKSON (JSON) -->
            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-rest-client</artifactId>
                <version>${domino-rest.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-rest-processor</artifactId>
                <version>${domino-rest.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-jackson</artifactId>
                <version>${domino-jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dominokit</groupId>
                <artifactId>domino-jackson-processor</artifactId>
                <version>${domino-jackson.version}</version>
            </dependency>

            <!-- ELEMENTAL2: una sola versione, altrimenti Maven mescola 1.1.0 e 1.3.2 -->
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-core</artifactId>
                <version>${elemental2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-dom</artifactId>
                <version>${elemental2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.elemental2</groupId>
                <artifactId>elemental2-promise</artifactId>
                <version>${elemental2.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <properties>
        <gwt.version>2.13.1</gwt.version>
        <gxt.version>2.3.2a-gwt211</gxt.version>
        <restygwt.version>2.2.7</restygwt.version>
        <domino-rest.version>2.0.2</domino-rest.version>
        <domino-jackson.version>1.0.6</domino-jackson.version>
        <elemental2.version>1.3.2</elemental2.version>
    </properties>

</project>
